# SmartReco environment configuration.
# Copy this file to `.env` (cp .env.example .env) and fill in the values
# below — `.env` is gitignored and never committed.
#
# Required: MESH_API_KEY (the only value you must change to run the app).
# Everything else has a working default for local dev via `make up-build`,
# or is an optional bonus feature (SMTP digest, LangSmith tracing) that's
# safely inert until explicitly configured.

# Mesh API — mandatory for every AI call (embeddings + chat completions)
MESH_API_KEY=rsk_your_key_here

# Relational DB — SQLite for local dev; swap to a Postgres DSN for production.
# NOTE: when running via `make up`/Docker Compose (the supported path), this
# value is always overridden by docker-compose.yml's `environment:` block, so
# the app writes to the container's bind-mounted /app/data instead. This
# value only applies if you run something directly on the host with `uv run`.
DATABASE_URL=sqlite:///./smartreco.db

# Vector DB — local Docker Qdrant by default; point at Qdrant Cloud URL for deploy.
# NOTE: same as above — Docker Compose always overrides this to the in-network
# `http://qdrant:6333`, since "localhost" inside the container isn't the
# Qdrant container. This value only applies to host-run `uv run` commands.
QDRANT_URL=http://localhost:6333

# Session cookie signing secret — set to a long random string
SESSION_SECRET=change-me-to-a-random-secret

# Working-set size for catalog seeding (Section 9.1 of the SRS)
CATALOG_LIMIT=1500

# Public URL the app is actually reachable at - used to build absolute links
# in the digest email (dashboard/course links), since an email is opened
# outside any browser session tied to the app's own host. Defaults to
# localhost for local dev; set this to your real deployed URL in production.
PUBLIC_BASE_URL=http://localhost:8000

# Root logger level - DEBUG for verbose local troubleshooting, WARNING (or
# higher) to quiet things down in production. Defaults to INFO.
LOG_LEVEL=INFO

# --- Bonus: scheduled email digest (optional — falls back to console logging if unset) ---
# For local testing, `make up`/`make up-build` also start a MailHog SMTP
# catcher (dev-only, docker-compose.override.yml) — set SMTP_HOST=mailhog,
# SMTP_PORT=1025, and leave SMTP_USER/PASSWORD blank (MailHog has no auth) to
# send real digest emails there and view them at http://localhost:8025,
# without needing real credentials or spamming a real inbox. For an actual
# relay (e.g. Gmail), set SMTP_HOST to it and fill in SMTP_USER/PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=

# --- Bonus: LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
# Defaults to "smartreco" if unset - set this to match an existing LangSmith
# project name (e.g. from your dashboard's quickstart snippet) if you want
# traces to land there instead.
LANGCHAIN_PROJECT=
